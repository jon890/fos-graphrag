# Neo4j 비밀번호. 기본값은 없다. 비어 있으면 Compose 와 API 가 시작하지 않는다
NEO4J_PASSWORD=

# Google OAuth client. 기본값은 없다. 비어 있으면 API 가 시작하지 않는다. 만드는 순서는 docs/deployment.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 사용자가 한 명도 없을 때 시작하면서 만들 첫 ADMIN 의 Google 이메일
WORKBENCH_BOOTSTRAP_ADMIN_EMAIL=

# app 을 열 호스트 주소와 포트. 앞단 reverse proxy 가 같은 호스트에 있으면 127.0.0.1 그대로 둔다
# 8080 은 다른 서비스와 겹치기 쉬워 기본값으로 쓰지 않는다
WORKBENCH_BIND=127.0.0.1
WORKBENCH_PORT=8081

# TLS 를 끝내는 앞단 뒤에서 쓴다. 로컬 HTTP 로 직접 열 때만 false 로 바꾼다
WORKBENCH_SECURE_COOKIE=true
WORKBENCH_FORWARD_HEADERS_STRATEGY=native
WORKBENCH_SESSION_TIMEOUT=8h
# 앞단이 HSTS 를 붙이지 않을 때만 true
WORKBENCH_HSTS=false

# 메모리 상한. 근거는 docs/deployment.md 의 「자원 설정」 절
WORKBENCH_NEO4J_MEM_LIMIT=1536m
NEO4J_HEAP_SIZE=512m
NEO4J_PAGECACHE_SIZE=512m
WORKBENCH_API_MEM_LIMIT=768m

# GHCR 이미지를 쓸 때. 비우면 로컬에서 빌드한 이미지를 쓴다
# WORKBENCH_IMAGE=ghcr.io/jon890/fos-graphrag-workbench:sha-xxxxxxx
